# Copien este archivo como .env y ajusten lo que necesiten.
DB_PASSWORD=cafeteria2026

# Clave del local: la piden las pantallas del personal (Mostrador, caja, cocina, turnos)
# en http://IP:8080/personal/  · Usuario: personal
CLAVE_PERSONAL=cambiar-esta-clave

# Contraseña del coordinador para entrar al dashboard (déjenla vacía para quitarla)
DASHBOARD_PASSWORD=coordinador2026

# Puertos en su computador
# n8n usa el 5679 para no chocar con otro n8n que ya tengan en el 5678
N8N_PORT=5679
WEB_PORT=8080
DASHBOARD_PORT=8501
DB_PORT=5433

# Dirección que codifica el QR. Para que los celulares la abran, pongan la IP
# de su PC en la red Wi-Fi, ej. http://192.168.1.20:8080
URL_PUBLICA=http://localhost:8080

# Opcional: avisos por Telegram (gratis). Ver README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CANAL_TURNOS=
