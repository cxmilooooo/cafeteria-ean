      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -400,
        -260
      ],
      "parameters": {
        "content": "## 02 · Recepción de pedido\n`POST /webhook/pedido`\n\n1. Valida la estructura (canal, cantidades, nombre).\n2. La base de datos revisa disponibilidad, asigna el **turno único del día** (RN-03), guarda PEDIDO + DETALLE con `hora_llegada_fila` y `hora_toma_pedido` (RF-10) y registra la NOTIFICACION *Pedido recibido*.\n3. Responde el turno al celular o a la caja. El pedido queda *Registrado* esperando la autorización del cajero.\n\nEl pedido se registra **una sola vez** (fricción 3).",
        "width": 380,
        "height": 300,
        "color": 7
      }
    },
    {
      "id": "0c9795e6-716c-5840-8ed8-3412ae068acf",
      "name": "POST /pedido",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "pedido",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "ddcbcf46-69de-5a60-aab0-3bcbdaf6a7f1"
    },
    {
      "id": "6dd19195-b593-541c-baa6-e3f7f3556a70",
      "name": "Validar y normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst errores = [];\nconst canal = b.canal === 'Caja' ? 'Caja' : (b.canal === 'QR' ? 'QR' : null);\nif (!canal) errores.push('canal debe ser QR o Caja');\nconst caf = parseInt(b.id_cafeteria, 10);\nif (!caf) errores.push('id_cafeteria es obligatorio');\nconst items = Array.isArray(b.items) ? b.items : [];\nif (items.length === 0) errores.push('el pedido debe tener al menos un producto');\nconst limpios = items.map(i => ({\n  id_producto: parseInt(i.id_producto, 10),\n  cantidad: parseInt(i.cantidad, 10),\n  observaciones: (i.observaciones ?? '').toString().slice(0, 150)\n}));\nif (limpios.some(i => !i.id_producto || !(i.cantidad >= 1 && i.cantidad <= 20)))\n  errores.push('cada producto necesita id y cantidad entre 1 y 20');\nconst cli = b.cliente ?? {};\n// El nombre es obligatorio en ambos canales: se muestra en la pantalla de turnos cuando el pedido está listo\nif (!(cli.nombre ?? '').trim()) errores.push('el nombre del cliente es obligatorio (se muestra en la pantalla al estar listo)');\nif (canal === 'Caja' && (!b.id_cajero || !b.pin)) errores.push('un pedido en caja necesita el cajero que lo registra y su PIN');\n// Ley 1581: los datos de contacto solo viajan si hay autorización explícita\nconst autoriza = cli.autoriza_datos === true;\nconst pedido = {\n  id_cafeteria: caf, canal, id_cajero: b.id_cajero ?? null, pin: canal === 'Caja' ? (b.pin ?? null) : null,\n  segundos_espera: Math.max(0, Math.min(1800, parseInt(b.segundos_espera, 10) || 0)),\n  cliente: { nombre: (cli.nombre ?? '').trim(), tipo_cliente: cli.tipo_cliente ?? 'Otro',\n             autoriza_datos: autoriza,\n             celular: autoriza ? (cli.celular ?? null) : null,\n             correo_institucional: autoriza ? (cli.correo_institucional ?? null) : null },\n  items: limpios\n};\nreturn [{ json: { valido: errores.length === 0, errores, pedido } }];"
      }
    },
