        "jsCode": "const r = $input.first().json.r;\n// Canal público: solo el número de turno (el nombre se ve únicamente en la pantalla del punto de entrega)\nreturn [{ json: { mensaje: `✅ Turno ${r.numero_turno} listo. Acércate al punto de entrega.` } }];"
