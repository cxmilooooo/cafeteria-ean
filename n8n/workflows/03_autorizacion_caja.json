    {
      "id": "ae6b9a7e-1ec9-5688-a956-064803aa51f8",
      "name": "Validar solicitud del cajero",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst errores = [];\nif (!(b.id_pedido ?? '').toString().trim()) errores.push('falta el número de pedido');\nif (!parseInt(b.id_cajero, 10) || !b.pin) errores.push('falta el cajero que autoriza o su PIN');\nreturn [{ json: { valido: errores.length === 0, errores,\n  autorizacion: { id_pedido: (b.id_pedido ?? '').toString().trim().toUpperCase(),\n                  id_cajero: parseInt(b.id_cajero, 10) || null, pin: (b.pin ?? '').toString(),\n                  medio_pago: b.medio_pago ?? 'Efectivo' } } }];"
      }
    },
